# Force LF line endings for all text files
* text=auto eol=lf

# Explicitly mark binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.avif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.safetensors binary
*.pt binary
*.pth binary
*.ckpt binary
*.bin binary
*.pkl binary
